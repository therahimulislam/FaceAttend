# =============================================================================
# FaceAttend — Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# Variables exposed to browser MUST be prefixed with VITE_
# NEVER put secrets in frontend environment variables.
# =============================================================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend WebSocket URL (for real-time attendance — Phase 13)
VITE_WS_BASE_URL=ws://localhost:8000/ws

# App metadata
VITE_APP_NAME=FaceAttend
VITE_APP_TAGLINE=Smart Attendance. Verified Presence.

# Feature flags (set to "true" or "false")
# These are non-security flags — they control UI behaviour only.
# The backend independently enforces all security rules regardless of these flags.
VITE_FEATURE_FACE_RECOGNITION=false
VITE_FEATURE_LIVENESS_DETECTION=false
VITE_FEATURE_GPS_VERIFICATION=false
