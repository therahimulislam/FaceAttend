# =============================================================================
# FaceAttend — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Environment / Secrets — NEVER COMMIT THESE
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env

# -----------------------------------------------------------------------------
# Python / Django
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
/lib/
lib64/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_collected/

# Celery
celerybeat-schedule
celerybeat.pid

# Pytest
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# -----------------------------------------------------------------------------
# Node.js / Frontend
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
frontend/dist/
frontend/build/
frontend/.vite/

# TypeScript
*.tsbuildinfo

# Vite
frontend/dist-ssr/

# PWA
frontend/public/sw.js
frontend/public/workbox-*.js

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker/

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln

# JetBrains
*.iml

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Biometric / Sensitive Data — NEVER COMMIT
# -----------------------------------------------------------------------------
*.npy
*.npz
face_embeddings/
captured_images/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.bak
*.tmp
*.orig
.cache/

# Backend virtualenv (local development)
backend/.venv/

# Dev SQLite (local non-Docker testing only)
backend/db_dev.sqlite3

# Frontend build
frontend/dist/

# Pytest cache
backend/.pytest_cache/
backend/pytest.ini
