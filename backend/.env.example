# =============================================================================
# FaceAttend — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-secret-key-here-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=faceattend
POSTGRES_USER=faceattend_user
POSTGRES_PASSWORD=faceattend_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full DATABASE_URL (alternative to above individual vars)
# DATABASE_URL=postgresql://faceattend_user:faceattend_pass@db:5432/faceattend

# -----------------------------------------------------------------------------
# Redis / Valkey
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
DJANGO_CHANNELS_LAYER_URL=redis://redis:6379/3

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# -----------------------------------------------------------------------------
# Campus Geofence
# (Set to your university campus center coordinates and allowed radius in metres)
# -----------------------------------------------------------------------------
CAMPUS_LATITUDE=0.000000
CAMPUS_LONGITUDE=0.000000
CAMPUS_GEOFENCE_RADIUS_METERS=500

# -----------------------------------------------------------------------------
# Email (Development: uses console backend by default)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=FaceAttend <noreply@example.com>

# -----------------------------------------------------------------------------
# Face Recognition
# -----------------------------------------------------------------------------
# Model version tag — used to track which embedding model was used per profile.
# If the model is updated, this version must be bumped and students re-enrolled.
FACE_MODEL_VERSION=v1

# Cosine similarity threshold for face recognition (0.0–1.0).
# Higher = stricter. Recommended starting value: 0.6
FACE_RECOGNITION_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# Media Storage
# -----------------------------------------------------------------------------
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# -----------------------------------------------------------------------------
# Attendance Session
# -----------------------------------------------------------------------------
# Default session expiry in minutes
ATTENDANCE_SESSION_DEFAULT_EXPIRY_MINUTES=15

# Rate limiting: max verification attempts per student per 10 minutes
ATTENDANCE_MAX_ATTEMPTS_PER_WINDOW=5

# -----------------------------------------------------------------------------
# Security (Production only — leave commented in development)
# -----------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
